    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst phoneRegex = /^\\d{10}$/;\n\nconst output = [];\n\nfor (const item of items) {\n\n  // Get JSON string from the text field\n  let data;\n\n  try {\n    data = JSON.parse(item.json.text);\n  } catch (error) {\n    output.push({\n      json: {\n        Error: \"Invalid JSON in text field\",\n        Raw_Text: item.json.text,\n        Record_Valid: false,\n        Cleaned: false\n      }\n    });\n\n    continue;\n  }\n\n  // Trim all string values\n  for (const key of Object.keys(data)) {\n    if (typeof data[key] === \"string\") {\n      data[key] = data[key].trim();\n    }\n  }\n\n  // Email validation\n  const emailValid = emailRegex.test(data.Email || \"\");\n\n  // Phone validation\n  const phoneValid = phoneRegex.test(\n    String(data.Phone || \"\")\n  );\n\n  // Required fields\n  const requiredFields = [\n    \"Student_ID\",\n    \"Name\",\n    \"Email\",\n    \"Phone\",\n    \"Course\",\n    \"City\",\n    \"Enrolled_Date\"\n  ];\n\n  const missingFields = requiredFields.filter(field =>\n    data[field] === undefined ||\n    data[field] === null ||\n    String(data[field]).trim() === \"\"\n  );\n\n  // Overall record validation\n  const recordValid =\n    emailValid &&\n    phoneValid &&\n    missingFields.length === 0;\n\n  // Add cleaned record\n  output.push({\n    json: {\n      Student_ID: data.Student_ID,\n      Name: data.Name,\n      Email: data.Email,\n      Phone: data.Phone,\n      Course: data.Course,\n      Fee_Paid: data.Fee_Paid,\n      City: data.City,\n      Enrolled_Date: data.Enrolled_Date,\n\n      Email_Valid: emailValid,\n      Phone_Valid: phoneValid,\n      Missing_Fields: missingFields,\n      Record_Valid: recordValid,\n      Cleaned: true\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
